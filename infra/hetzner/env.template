# ============================================================================
# apps/api/.env — Hetzner production
#
# Use this when Railway is suspended and pull-railway-env.sh cannot reach it.
# Copy to the VPS as /opt/topaz/apps/api/.env, fill every <ANGLE_BRACKET>, then:
#     chmod 600 /opt/topaz/apps/api/.env
#     bash /opt/topaz/infra/hetzner/preflight.sh
#
# Only DATABASE_URL and EDGE_API_KEY are enforced by Pydantic at startup. The
# rest either have safe defaults or FAIL CLOSED at runtime — which is worse,
# because the stack boots green and breaks when staff first touch it. preflight.sh
# checks the fail-closed ones; fill everything marked REQUIRED.
# ============================================================================

# ── Database (REQUIRED) ──────────────────────────────────────────────────────
# Supabase → Settings → Database → Connection string → URI → "Session pooler"
# (port 5432, NOT the 6543 transaction pooler).
# Then change the prefix postgresql:// to postgresql+asyncpg:// — asyncpg
# refuses to start otherwise, and config.py validates this at boot.
DATABASE_URL=postgresql+asyncpg://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# If you must use the 6543 transaction pooler instead, ALSO set this to true or
# every second query dies with DuplicatePreparedStatementError:
# DB_DISABLE_PREPARED_STATEMENT_CACHE=true

# ── Redis (REQUIRED — do not change) ─────────────────────────────────────────
# The compose service name on the internal network. Railway's
# ${{Redis.REDIS_URL}} does not resolve here.
REDIS_URL=redis://redis:6379/0

# ── Internal auth keys (REQUIRED) ────────────────────────────────────────────
# If Railway still shows these, COPY them — regenerating forces you to update
# every caller. If lost, generate with:  openssl rand -hex 32
#
# Regenerating DASHBOARD_API_KEY -> also update it in Vercel, or the dashboard 401s.
# Regenerating EDGE_API_KEY      -> also update the edge box, or the camera 401s.
EDGE_API_KEY=<openssl rand -hex 32>
DASHBOARD_API_KEY=<openssl rand -hex 32>

# ── WhatsApp Cloud API (REQUIRED) ────────────────────────────────────────────
# Known-good, verified 2026-07-10 against the Graph API — do not change:
WA_PHONE_NUMBER_ID=1189429440922862

# business.facebook.com → Settings → Users → System users → topaz-crm-server
# → Generate new token → expiry Never → scopes whatsapp_business_messaging
# + whatsapp_business_management. Meta shows it ONCE; if Railway lost it you
# must reissue. Reissuing does not require re-verification.
WA_TOKEN=<META_SYSTEM_USER_TOKEN>

# developers.facebook.com → your app → App settings → Basic → App secret → Show.
# Unset = webhook signatures are NOT verified and POSTs 503 by design.
WA_APP_SECRET=<META_APP_SECRET>

# Any random string you choose — it just has to MATCH what you enter in the Meta
# webhook config. If you set a new one here, update Meta and re-verify.
WA_WEBHOOK_VERIFY_TOKEN=<RANDOM_STRING>

# ── Supabase (REQUIRED) ──────────────────────────────────────────────────────
# Settings → API
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY>
FACE_CROP_BUCKET=face-crops

# Settings → API → JWT Settings → JWT Secret.
# FAILS CLOSED: unset means every identity-gated money/write route returns 503.
SUPABASE_JWT_SECRET=<JWT_SECRET>

# Auth → Hooks → "Send SMS" hook → signing secret. Copy verbatim, including the
# v1,whsec_ prefix. FAILS CLOSED: unset means OTP login 401s for everyone.
SUPABASE_SEND_SMS_HOOK_SECRET=<v1,whsec_...>

# ── AI drafts (optional) ─────────────────────────────────────────────────────
# Unset = follow-up drafts fall back to built-in template text.
# ANTHROPIC_API_KEY=<sk-ant-...>

# ── Dashboard (REQUIRED) ─────────────────────────────────────────────────────
# The live Vercel URL. Wrong value = broken links inside WhatsApp messages.
DASHBOARD_URL=https://topaz-crm.vercel.app

# ── Recognition tuning (non-secret, safe defaults) ───────────────────────────
MATCH_THRESHOLD=0.45
NEW_THRESHOLD=0.30
HNSW_EF_SEARCH=40
QUALITY_FLOOR=0.2
ENROLLMENT_PENDING_WINDOW_SECONDS=120

# ── Cadence engine (non-secret) ──────────────────────────────────────────────
# 10, not the old 120. Beat runs */5, so the real delay is 10-15 min — the
# customer is typically still in the showroom.
WELCOME_FOLLOWUP_DELAY_MINUTES=10
FOLLOWUP_BATCH_SIZE=25
FOLLOWUP_STALE_DAYS=3

# ── Messaging (non-secret) ───────────────────────────────────────────────────
# Validated at startup (>= 10 digits): Meta rejects a template send with an
# empty parameter, so a bad value here stops the API booting.
SHOWROOM_CONTACT_NUMBER=+91 63563 20206

# Flip to true ONLY after WhatsApp Manager shows topaz_welcome_v2 APPROVED.
WELCOME_TEMPLATE_V2=false

# ── Delivery challan (non-secret) ────────────────────────────────────────────
# Seed doc_series with their real last paper number before the first challan,
# or numbering restarts at 1 and duplicates issued numbers:
#   insert into doc_series (series, fiscal_year, last_no) values ('CHL','ALL',66)
#     on conflict (series, fiscal_year) do update set last_no = excluded.last_no;
CHALLAN_NO_PREFIX=T.F
