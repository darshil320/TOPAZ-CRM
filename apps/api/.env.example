# Topaz CRM API — environment variables
# Copy to .env and fill in real values before running.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@db.xxxx.supabase.co:5432/postgres
REDIS_URL=redis://localhost:6379/0

# API connection pool (src/database.py::get_api_session). HTTP routes share this
# pool so a write does not pay a TCP+TLS connect first. DB_POOL_SIZE +
# DB_MAX_OVERFLOW is the ceiling this process can hold on the Supabase pooler at
# once — the workers draw on the same budget, so raise both together, not blindly.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT_SECONDS=10
# DB_POOL_RECYCLE_SECONDS=900
# Set TRUE only if DATABASE_URL is a TRANSACTION-mode pooler (Supabase port 6543).
# Leave false for the session pooler (port 5432) and for a direct connection.
# DB_DISABLE_PREPARED_STATEMENT_CACHE=false

# ── Auth ──────────────────────────────────────────────────────────────────────
# Pre-shared key sent by the edge worker in the API-Key header.
EDGE_API_KEY=change_me_at_least_32_chars

# Pre-shared key used by Next.js server actions to call /api/whatsapp/send.
DASHBOARD_API_KEY=change_me_at_least_32_chars

# ── Recognition tuning ────────────────────────────────────────────────────────
MATCH_THRESHOLD=0.45
NEW_THRESHOLD=0.30
HNSW_EF_SEARCH=40
QUALITY_FLOOR=0.2   # server-side floor on edge-reported face quality (bench-permissive; raise on-site)

# ── WhatsApp Cloud API (Meta) ─────────────────────────────────────────────────
# Leave unset in local dev to skip real WA sends (logs a warning instead).
# WA_PHONE_NUMBER_ID=123456789012345
# WA_TOKEN=EAAxxxxxxxxxxxxxx            # System User permanent token (not the 24h dev token)
# WA_WEBHOOK_VERIFY_TOKEN=random_string_you_choose
# WA_APP_SECRET=xxxxxxxxxxxxxxxx        # Meta App Secret — verifies webhook signatures.
#                                       # UNSET = webhook signature NOT checked (dev only).

# ── AI drafts ─────────────────────────────────────────────────────────────────
# Unset = follow-up drafts fall back to the built-in template text.
# ANTHROPIC_API_KEY=sk-ant-xxxx

# ── Supabase Storage (face-crop for salesperson arrival alert) ────────────────
# Both required to attach the customer photo to the WhatsApp alert; if unset the
# alert is text-only. SUPABASE_URL is the project URL, service-role key never in browser.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# FACE_CROP_BUCKET=face-crops

# ── Kiosk consent seam (§19-E) ────────────────────────────────────────────────
# How long a kiosk enrollment stays claimable by the entrance camera (seconds).
ENROLLMENT_PENDING_WINDOW_SECONDS=120

# ── Cadence engine (Celery beat) ──────────────────────────────────────────────
# Kiosk enrollment → welcome WhatsApp. 10 minutes: the customer is typically still in
# the showroom, so the advisor's number in the message is immediately actionable.
# The beat runs every 5 min, so the real delay is 10–15 min.
WELCOME_FOLLOWUP_DELAY_MINUTES=10
FOLLOWUP_BATCH_SIZE=25
FOLLOWUP_STALE_DAYS=3

# ── Welcome message: the advisor's phone number ───────────────────────────────
# Fallback advisor number for a customer nobody has claimed yet. Validated at
# startup (>= 10 digits): Meta rejects a template send with an empty parameter.
SHOWROOM_CONTACT_NUMBER=+91 63563 20206
# Send the welcome via topaz_welcome_v2 (adds {{advisor_phone}}) instead of
# topaz_welcome. Flip to true ONLY after WhatsApp Manager shows v2 APPROVED.
# The in-window (free-form) message carries the number regardless of this flag.
WELCOME_TEMPLATE_V2=false

# ── Delivery challan (0037) ───────────────────────────────────────────────────
# Number prefix on the challan — the client's pad reads "T.F 66". The counter is
# CONTINUOUS (no fiscal year); seed doc_series with their real last number before
# first use, or the app restarts at 1 and duplicates issued numbers:
#   insert into doc_series (series, fiscal_year, last_no) values ('CHL','ALL',66)
#     on conflict (series, fiscal_year) do update set last_no = excluded.last_no;
CHALLAN_NO_PREFIX=T.F

# ── Dashboard ─────────────────────────────────────────────────────────────────
DASHBOARD_URL=https://topaz-crm.vercel.app/
